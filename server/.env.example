# Auteur : BB_NUMERIQUE - LUKUNKU K.SARAH
# server/.env.example : configuration de l'API lancée en natif (sans Docker).
# Copier ce fichier vers server/.env (ignoré par git), puis `npm run dev` dans server/.
# Les identifiants sont ceux du docker-compose.yml ; les bases tournent sur Windows.

# API
API_PORT=3000
CORS_ORIGIN=http://localhost:5173

# PostgreSQL 16 (port par défaut de l'installateur Windows)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=eventflow_db
POSTGRES_USER=eventflow_user
POSTGRES_PASSWORD=eventflow_secret_2024

# MariaDB 11 (port par défaut de l'installateur Windows)
MARIADB_HOST=127.0.0.1
MARIADB_PORT=3306
MARIADB_DATABASE=eventflow_logs
MARIADB_USER=eventflow_user
MARIADB_PASSWORD=eventflow_secret_2024
